# The one formatting of every C source and header (R-STYLE-1), checked by
# CTest's rules.format under TRL_LINT. `clang-format -i FILE` applies it.
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
PointerAlignment: Right
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
InsertBraces: true
InsertNewlineAtEOF: true
KeepEmptyLines:
  AtStartOfFile: false
IncludeBlocks: Regroup
IncludeCategories:
  # The file's own header first, then ours, then the C library's.
  - Regex: '^"'
    Priority: 1
  - Regex: '^<turborel/'
    Priority: 2
  - Regex: '^<'
    Priority: 3
SortIncludes: CaseSensitive
...
