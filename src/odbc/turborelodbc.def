    SQLGetCursorNameW
    SQLGetData
    SQLGetDescField
    SQLGetDescFieldW
    SQLGetDescRec
    SQLGetDiagField
    SQLGetDiagFieldW
    SQLGetDiagRec
    SQLGetDiagRecW
    SQLGetEnvAttr
