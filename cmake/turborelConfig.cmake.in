# The CMake package of libturborel: find_package(turborel) gives the
# target turborel::turborel.
@PACKAGE_INIT@

# A static library brings the libraries it was built with to its users.
include(CMakeFindDependencyMacro)
@TRL_CONFIG_DEPENDENCIES@

include("${CMAKE_CURRENT_LIST_DIR}/turborelTargets.cmake")
check_required_components(turborel)
