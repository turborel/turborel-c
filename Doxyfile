# The API reference of libturborel, from the public header's doc comments
# (RULES.md D10, R-DOC-1). CI builds it with every warning an error, so an
# item left undocumented fails: `doxygen Doxyfile` writes build/doc/.
PROJECT_NAME           = libturborel
PROJECT_BRIEF          = "The C driver for turborel"
OUTPUT_DIRECTORY       = build/doc
INPUT                  = include/turborel
FILE_PATTERNS          = *.h
RECURSIVE              = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
MARKDOWN_SUPPORT       = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
PREDEFINED             = TRL_API=
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
